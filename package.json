{
  "name": "webseclab",
  "version": "1.0.0",
  "private": true,
  "description": "WebSecLab — web-based attack detection, prevention and forensic analysis platform (educational, local use only)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:reset": "node database/reset.js",
    "db:seed": "node database/seed.js",
    "test:detectors": "node scripts/test-detectors.js",
    "test:risk": "node scripts/test-risk.js",
    "test:outcome": "node scripts/test-outcome-model.js",
    "test:acceptance": "node scripts/acceptance.js",
    "demo:traffic": "node scripts/demo-traffic.js",
    "test": "npm run test:detectors && npm run test:risk && npm run test:outcome"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
