<%
  const isActive = (href) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
  const isAdmin = user && user.role === 'ADMIN';
%>
<aside class="ws-sidebar" id="ws-sidebar">
  <%# Two elements on purpose: the <aside> is the full-height rail (background
      and right border all the way down), while the inner box is what sticks.
      Making the rail itself sticky would size it to its content and leave the
      divider hanging in mid-page. %>
  <div class="ws-sidebar__inner">
  <div class="ws-sidebar__head">
    <span class="ws-sidebar__title">Navigation</span>
    <button class="ws-sidebar__close" type="button" data-nav-close aria-label="Close navigation">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>
    </button>
  </div>
  <nav aria-label="Sections">
    <% if (isAdmin) { %>
      <div class="ws-nav__group">Console</div>
      <ul class="ws-nav">
        <li>
          <a class="ws-nav__link <%= isActive('/dashboard') ? 'is-active' : '' %>" href="/dashboard"
             <%= isActive('/dashboard') ? 'aria-current="page"' : '' %>>
            <svg class="ws-nav__icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="1.8" y="1.8" width="5.2" height="5.2" rx="1"/><rect x="9" y="1.8" width="5.2" height="5.2" rx="1"/><rect x="1.8" y="9" width="5.2" height="5.2" rx="1"/><rect x="9" y="9" width="5.2" height="5.2" rx="1"/></svg>
            Dashboard
          </a>
        </li>
        <li>
          <a class="ws-nav__link <%= isActive('/security/events') ? 'is-active' : '' %>" href="/security/events"
             <%= isActive('/security/events') ? 'aria-current="page"' : '' %>>
            <svg class="ws-nav__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4h11M2.5 8h11M2.5 12h6"/></svg>
            Security Events
          </a>
        </li>
        <li>
          <a class="ws-nav__link <%= isActive('/forensics/verify') ? 'is-active' : '' %>" href="/forensics/verify"
             <%= isActive('/forensics/verify') ? 'aria-current="page"' : '' %>>
            <svg class="ws-nav__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.8 13 3.6v4.6c0 3-2 5.6-5 7-3-1.4-5-4-5-7V3.6z"/><path d="M5.8 8.1l1.7 1.7 3.1-3.2"/></svg>
            Verify Evidence
          </a>
        </li>
      </ul>
    <% } %>

    <div class="ws-nav__group">Labs</div>
    <ul class="ws-nav">
      <li>
        <a class="ws-nav__link <%= isActive('/labs/sql') ? 'is-active' : '' %>" href="/labs/sql"
           <%= isActive('/labs/sql') ? 'aria-current="page"' : '' %>>
          <svg class="ws-nav__icon" viewBox="0 0 16 16" aria-hidden="true"><ellipse cx="8" cy="3.4" rx="5.2" ry="2"/><path d="M2.8 3.4v9.2c0 1.1 2.3 2 5.2 2s5.2-.9 5.2-2V3.4"/><path d="M2.8 8c0 1.1 2.3 2 5.2 2s5.2-.9 5.2-2"/></svg>
          SQL Injection
        </a>
      </li>
      <li>
        <a class="ws-nav__link <%= isActive('/labs/xss') ? 'is-active' : '' %>" href="/labs/xss"
           <%= isActive('/labs/xss') ? 'aria-current="page"' : '' %>>
          <svg class="ws-nav__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4.5 2.5 8 6 11.5M10 4.5 13.5 8 10 11.5"/></svg>
          Cross-Site Scripting
        </a>
      </li>
      <li>
        <a class="ws-nav__link <%= isActive('/labs/idor') ? 'is-active' : '' %>" href="/labs/idor"
           <%= isActive('/labs/idor') ? 'aria-current="page"' : '' %>>
          <svg class="ws-nav__icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="5.2" cy="8" r="2.6"/><path d="M7.8 8H14M11.6 8v2.4"/></svg>
          IDOR
        </a>
      </li>
    </ul>
  </nav>
  </div>
</aside>
<div class="ws-drawer-backdrop" data-nav-close></div>
