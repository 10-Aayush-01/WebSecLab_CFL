<%
  // themeChoice is resolved server-side from the ws_theme cookie; public/js/theme.js
  // wires the buttons and keeps aria-pressed in sync. The markup is written out
  // literally rather than looped so that the project keeps exactly one unescaped
  // data render in the whole views tree (asserted by the acceptance suite).
  const isLight = themeChoice === 'light';
  const isDark = themeChoice === 'dark';
  const isSystem = themeChoice === 'system';
%>
<span class="ws-seg__label" id="theme-label">Theme</span>
<div class="ws-seg" role="group" aria-labelledby="theme-label">
  <button class="ws-seg__btn <%= isLight ? 'is-active' : '' %>" type="button"
          data-theme-choice="light" aria-pressed="<%= isLight ? 'true' : 'false' %>" title="Light theme">
    <svg class="ws-seg__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="3.2"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.2 3.2l1.4 1.4M11.4 11.4l1.4 1.4M12.8 3.2l-1.4 1.4M4.6 11.4l-1.4 1.4"/></svg>
    <span class="ws-sr-only">Light theme</span>
  </button>
  <button class="ws-seg__btn <%= isDark ? 'is-active' : '' %>" type="button"
          data-theme-choice="dark" aria-pressed="<%= isDark ? 'true' : 'false' %>" title="Dark theme">
    <svg class="ws-seg__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 9.6A5.6 5.6 0 1 1 6.4 3 4.6 4.6 0 0 0 13 9.6z"/></svg>
    <span class="ws-sr-only">Dark theme</span>
  </button>
  <button class="ws-seg__btn <%= isSystem ? 'is-active' : '' %>" type="button"
          data-theme-choice="system" aria-pressed="<%= isSystem ? 'true' : 'false' %>" title="Match the system theme">
    <svg class="ws-seg__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.8" y="2.8" width="12.4" height="8.4" rx="1.2"/><path d="M6 13.4h4M8 11.2v2.2"/></svg>
    <span class="ws-sr-only">Automatic theme</span>
  </button>
</div>
