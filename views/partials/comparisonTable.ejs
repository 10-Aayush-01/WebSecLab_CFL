<div class="ws-card">
  <div class="ws-card__title">Vulnerable vs Safe in this lab</div>
  <div class="ws-compare">
    <div class="ws-compare__col">
      <div class="ws-compare__head ws-compare__head--danger">Vulnerable mode</div>
      <dl class="ws-compare__body">
        <dt>Handling</dt>
        <dd><%= lab.comparison.vulnerable.handling %></dd>
        <dt>Outcome</dt>
        <dd><%= lab.comparison.vulnerable.outcome %></dd>
        <dt>Detection</dt>
        <dd><%= lab.comparison.vulnerable.detection %></dd>
        <dt>Logged result</dt>
        <dd><%= lab.comparison.vulnerable.result %></dd>
      </dl>
    </div>
    <div class="ws-compare__col">
      <div class="ws-compare__head ws-compare__head--success">Safe mode</div>
      <dl class="ws-compare__body">
        <dt>Handling</dt>
        <dd><%= lab.comparison.safe.handling %></dd>
        <dt>Outcome</dt>
        <dd><%= lab.comparison.safe.outcome %></dd>
        <dt>Detection</dt>
        <dd><%= lab.comparison.safe.detection %></dd>
        <dt>Logged result</dt>
        <dd><%= lab.comparison.safe.result %></dd>
      </dl>
    </div>
  </div>
</div>
