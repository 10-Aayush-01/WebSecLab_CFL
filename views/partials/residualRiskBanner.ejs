<% if (locals.residualRisk === true) { %>
  <div class="ws-banner ws-banner--warning">
    <div class="ws-banner__body">
      <span class="ws-banner__title">Residual-risk case — the protections were skipped for this attempt</span>
      The global mode is <strong><%= locals.globalMode %></strong>, but the outcome model let this one attempt through
      (<code>RESIDUAL_RISK_RATE=<%= locals.residualRiskRate %></code>). Everything on this page describes what really
      happened to this request, and the security event is stored with
      <code>outcomeBasis: RESIDUAL_RISK</code>. Switch the rate to <code>0</code> to make the mode decide every result.
    </div>
  </div>
<% } %>
