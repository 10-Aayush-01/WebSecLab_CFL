<%- include('../partials/head', { layout: (locals && locals.user) ? 'app' : 'auth', title: title, pageTitle: title }) %>

<div class="ws-card">
  <div class="ws-card__title">
    <span><%= title %></span>
    <span class="ws-badge ws-badge--<%= status >= 500 ? 'critical' : (status === 403 ? 'high' : 'neutral') %> ws-badge--no-dot">
      HTTP <%= status %>
    </span>
  </div>
  <p class="ws-mb-0"><%= message %></p>

  <% if (typeof detail !== 'undefined' && detail) { %>
    <div class="ws-rule"></div>
    <label class="ws-form__label" for="error-detail">Stack trace</label>
    <pre class="ws-sql-box" id="error-detail" style="max-height: 260px;"><%= detail %></pre>
    <p class="ws-card__note">Shown because NODE_ENV is not production.</p>
  <% } %>
</div>

<p class="ws-small">
  <a href="/">Back to the home page</a>
</p>

<%- include('../partials/foot', { layout: (locals && locals.user) ? 'app' : 'auth' }) %>
