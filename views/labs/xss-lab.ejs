<%- include('../partials/head', { title: title, pageTitle: pageTitle, purpose: purpose, breadcrumb: 'Labs / Cross-Site Scripting' }) %>

<% if (isVulnerable) { %>
  <div class="ws-banner ws-banner--warning">
    <div class="ws-banner__body">
      <span class="ws-banner__title">Intentionally insecure behaviour is enabled</span>
      Comments are rendered unescaped and this route's Content-Security-Policy is relaxed. Local lab testing only.
    </div>
  </div>
<% } %>

<%- include('../partials/residualRiskBanner') %>

<%- include('../partials/protectionPanel', { lab: lab, mode: mode }) %>

<div class="ws-card">
  <div class="ws-card__title">What this lab shows</div>
  <p><%= lab.explanation %></p>
</div>

<div class="ws-card">
  <div class="ws-card__title">Post a comment</div>
  <form method="post" action="/labs/xss/comments">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="ws-form__row">
      <label class="ws-form__label" for="comment">Comment</label>
      <textarea class="ws-input ws-input--mono" id="comment" name="comment" rows="3" maxlength="<%= maxCommentLength %>"
                aria-describedby="comment-help"><%= values.comment || '' %></textarea>
      <div class="ws-form__hint" id="comment-help">
        Stored exactly as submitted in both modes — the mode only changes how it is rendered.
      </div>
    </div>
    <% for (const error of errors) { %>
      <div class="ws-banner ws-banner--danger"><%= error.message %></div>
    <% } %>
    <div class="ws-form-actions">
      <button class="ws-btn ws-btn--primary" type="submit">Post comment</button>
      <span class="ws-small ws-muted">Maximum <%= maxCommentLength %> characters.</span>
    </div>
  </form>

  <div class="ws-rule"></div>
  <div class="ws-examples">
    <span class="ws-examples__item">
      Normal comment
      <code id="xss-example-normal"><%= lab.examples.normal %></code>
      <%- include('../partials/copyButton', { target: 'xss-example-normal', label: 'the normal comment' }) %>
    </span>
    <span class="ws-examples__item">
      Script tag
      <code id="xss-example-script"><%= lab.examples.attack %></code>
      <%- include('../partials/copyButton', { target: 'xss-example-script', label: 'the script tag payload' }) %>
    </span>
    <span class="ws-examples__item">
      Event handler
      <code id="xss-example-handler"><%= lab.examples.equivalent %></code>
      <%- include('../partials/copyButton', { target: 'xss-example-handler', label: 'the event handler payload' }) %>
    </span>
  </div>
  <p class="ws-card__note">
    Each payload has a copy button, so you can paste it into the comment box or straight into a replayed request without
    retyping angle brackets. The code is ellipsised to fit the row; the clipboard gets the complete payload.
  </p>
</div>

<div class="ws-card">
  <div class="ws-card__title">
    <span>Stored comments</span>
    <span class="ws-badge ws-badge--<%= rendersUnescaped ? 'critical' : 'neutral' %> ws-badge--no-dot">
      <%= rendersUnescaped ? 'rendered unescaped' : 'rendered escaped' %>
    </span>
  </div>

  <% if (rendersUnescaped) { %>
    <div class="ws-banner ws-banner--warning">
      <div class="ws-banner__body">Relaxed Content-Security-Policy on this route: inline script and inline handlers are allowed.</div>
    </div>
  <% } else { %>
    <div class="ws-banner ws-banner--info">
      <div class="ws-banner__body">
        HTML escaping is applied at render time under the strict Content-Security-Policy. A comment stored in VULNERABLE
        mode is now inert text — the database row is unchanged.
      </div>
    </div>
  <% } %>

  <% if (comments.length === 0) { %>
    <div class="ws-empty">
      <div class="ws-empty__title">No comments yet</div>
      Post the first one above to populate the lab.
    </div>
  <% } else { %>
    <% for (const comment of comments) { %>
      <div class="ws-comment">
        <div class="ws-comment__meta">
          <span><%= comment.author_email %></span>
          <span aria-hidden="true">·</span>
          <span><%= formatTimestamp(comment.created_at) %></span>
          <span aria-hidden="true">·</span>
          <span>id <span class="ws-mono"><%= comment.id %></span></span>
        </div>
        <div class="ws-comment__body">
          <% if (rendersUnescaped) { %>
            <%- comment.comment %>
          <% } else { %>
            <%= comment.comment %>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>

  <p class="ws-card__note">
    The session cookie is <code>httpOnly</code>, so <code>document.cookie</code> does not expose it even while script runs.
  </p>
</div>

<%- include('../partials/comparisonTable', { lab: lab }) %>

<p class="ws-small ws-muted"><%= lab.note %></p>

<%- include('../partials/foot') %>
