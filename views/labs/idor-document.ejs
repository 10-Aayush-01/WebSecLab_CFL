<%- include('../partials/head', { title: title, pageTitle: pageTitle, purpose: purpose, breadcrumb: 'Labs / IDOR / Document ' + requestedId }) %>

<%
  // The attempt, not the setting: the residual-risk model can have skipped the
  // ownership check while the global mode still says SAFE.
  const effectiveMode = locals.residualRisk === true ? 'VULNERABLE' : mode;
%>

<%- include('../partials/residualRiskBanner') %>

<% if (denied) { %>
  <div class="ws-banner ws-banner--danger">
    <div class="ws-banner__body">
      <span class="ws-banner__title">HTTP 403 — You do not own this document</span>
      The server-side ownership check refused the request and no content was sent.
    </div>
  </div>
<% } else if (!isOwner) { %>
  <div class="ws-banner ws-banner--warning">
    <div class="ws-banner__body">
      <span class="ws-banner__title">Another user's document was returned</span>
      This belongs to <strong><%= document.owner_email %></strong>.
      <% if (locals.residualRisk === true) { %>
        The residual-risk model skipped the ownership check for this attempt, so it was returned with HTTP 200 while the
        global mode was SAFE.
      <% } else { %>
        In VULNERABLE mode no ownership check ran, so it was returned with HTTP 200.
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="ws-banner ws-banner--info">
    <div class="ws-banner__body">You own this document, so it is served in both modes and no security event is recorded.</div>
  </div>
<% } %>

<div class="ws-card">
  <div class="ws-card__title">
    <span>Authorization result</span>
    <% if (denied) { %>
      <span class="ws-badge ws-badge--blocked">BLOCKED</span>
    <% } else if (effectiveMode === 'VULNERABLE' && !isOwner) { %>
      <span class="ws-badge ws-badge--successful">SUCCESSFUL</span>
    <% } else { %>
      <span class="ws-badge ws-badge--neutral ws-badge--no-dot">NO EVENT</span>
    <% } %>
  </div>
  <dl class="ws-kv ws-kv--rows">
    <dt>Signed-in user</dt>
    <dd><%= currentUser.email %> <span class="ws-muted ws-small">id <%= currentUser.id %>, <%= currentUser.role %></span></dd>

    <dt>Requested document id</dt>
    <dd>
      <span class="ws-mono"><%= requestedId %></span>
      <span class="ws-flex ws-flex-wrap ws-mt-3">
        <span class="ws-mono ws-small" id="doc-request-path">/labs/idor/documents/<%= requestedId %></span>
        <%- include('../partials/copyButton', { target: 'doc-request-path', label: 'this request path' }) %>
      </span>
      <span class="ws-flex ws-flex-wrap ws-mt-3">
        <span class="ws-mono ws-small" id="doc-next-path">/labs/idor/documents/<%= requestedId + 1 %></span>
        <%- include('../partials/copyButton', { target: 'doc-next-path', label: 'the request path for the next id' }) %>
        <span class="ws-small ws-muted">next id — the ids are sequential on purpose</span>
      </span>
    </dd>

    <dt>Document owner</dt>
    <dd><%= document.owner_email %> <span class="ws-muted ws-small">id <%= document.owner_id %></span></dd>

    <dt>Ownership check</dt>
    <dd>
      <% if (effectiveMode === 'VULNERABLE') { %>
        <span class="ws-state ws-state--off">NOT PERFORMED</span>
        <span class="ws-small ws-muted">the controller returns the document without comparing the owner</span>
      <% } else if (denied) { %>
        <span class="ws-state ws-state--on">PERFORMED</span>
        <span class="ws-small ws-muted">owner mismatch, request refused</span>
      <% } else { %>
        <span class="ws-state ws-state--on">PERFORMED</span>
        <span class="ws-small ws-muted">owner matched, request served</span>
      <% } %>
    </dd>

    <dt>HTTP status</dt>
    <dd class="ws-mono"><%= denied ? 403 : 200 %></dd>

    <dt>Security mode</dt>
    <dd>
      <%= mode %>
      <% if (locals.residualRisk === true) { %>
        <span class="ws-small ws-muted">— this attempt was let through by the outcome model</span>
      <% } %>
    </dd>
  </dl>
</div>

<% if (!denied) { %>
  <div class="ws-card">
    <div class="ws-card__title"><%= document.title %></div>
    <p><%= document.content %></p>
    <p class="ws-small ws-muted ws-mb-0">Document id <%= document.id %>, owned by <%= document.owner_email %>.</p>
  </div>
<% } else { %>
  <div class="ws-card">
    <div class="ws-card__title">Document withheld</div>
    <p class="ws-mb-0 ws-dim">
      The title and content are deliberately not sent when authorization fails — a 403 that still returns the payload
      would defeat the point of the check.
    </p>
  </div>
<% } %>

<%- include('../partials/comparisonTable', { lab: lab }) %>

<div class="ws-toolbar">
  <a class="ws-btn ws-btn--secondary" href="/labs/idor">Back to your documents</a>
  <a class="ws-btn ws-btn--secondary" href="/labs/idor/documents/<%= requestedId + 1 %>">Try id <%= requestedId + 1 %></a>
</div>

<%- include('../partials/foot') %>
