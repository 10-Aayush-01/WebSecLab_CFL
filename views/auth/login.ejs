<%- include('../partials/head', { layout: 'auth', title: 'Sign in', pageTitle: 'Sign in' }) %>

<div class="ws-card ws-card--form">
  <div class="ws-card__title">Sign in</div>
  <p class="ws-small ws-muted">Local lab accounts only. Nothing here is reachable from outside this machine.</p>

  <% for (const error of errors) { %>
    <div class="ws-banner ws-banner--danger">
      <div class="ws-banner__body"><%= error.message %></div>
    </div>
  <% } %>

  <form method="post" action="/login" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="ws-form__row">
      <label class="ws-form__label" for="email">Email</label>
      <input class="ws-input" id="email" name="email" type="email" value="<%= values.email || '' %>"
             autocomplete="username" required autofocus>
    </div>
    <div class="ws-form__row">
      <label class="ws-form__label" for="password">Password</label>
      <input class="ws-input" id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <div class="ws-form-actions">
      <button class="ws-btn ws-btn--primary" type="submit">Sign in</button>
      <a class="ws-btn--link" href="/register">Create an account</a>
    </div>
  </form>
</div>

<div class="ws-card">
  <div class="ws-card__title">Seeded demo accounts</div>
  <p class="ws-small ws-muted">
    Passwords are hashed with bcrypt at seed time. <code>npm run db:seed</code> resets them.
  </p>
  <div class="ws-cred">
    <div class="ws-cred__main">
      <span class="ws-badge ws-badge--accent ws-badge--no-dot">ADMIN</span>
      <span class="ws-cred__id">
        <span class="ws-cred__mail">admin@webseclab.local</span>
        <span class="ws-cred__pass">Admin-Lab-Demo-2026</span>
      </span>
    </div>
    <button class="ws-btn ws-btn--secondary ws-btn--small" type="button"
            data-fill-user="admin@webseclab.local" data-fill-pass="Admin-Lab-Demo-2026">Use</button>
  </div>

  <div class="ws-cred">
    <div class="ws-cred__main">
      <span class="ws-badge ws-badge--neutral ws-badge--no-dot">USER</span>
      <span class="ws-cred__id">
        <span class="ws-cred__mail">alice@webseclab.local</span>
        <span class="ws-cred__pass">User-Lab-Demo-2026</span>
      </span>
    </div>
    <button class="ws-btn ws-btn--secondary ws-btn--small" type="button"
            data-fill-user="alice@webseclab.local" data-fill-pass="User-Lab-Demo-2026">Use</button>
  </div>

  <div class="ws-cred">
    <div class="ws-cred__main">
      <span class="ws-badge ws-badge--neutral ws-badge--no-dot">USER</span>
      <span class="ws-cred__id">
        <span class="ws-cred__mail">bob@webseclab.local</span>
        <span class="ws-cred__pass">User-Lab-Demo-2026</span>
      </span>
    </div>
    <button class="ws-btn ws-btn--secondary ws-btn--small" type="button"
            data-fill-user="bob@webseclab.local" data-fill-pass="User-Lab-Demo-2026">Use</button>
  </div>
  <p class="ws-card__note">Alice and Bob are the two accounts used for the IDOR demonstration.</p>
</div>

<%- include('../partials/foot', { layout: 'auth' }) %>
