# ---------------------------------------------------------------------------
# WebSecLab — copy to .env and fill in local values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Application role: owns the schema and runs every non-lab query.
DATABASE_URL=postgres://webseclab_app:CHANGE_ME@127.0.0.1:5432/webseclab

# Least-privilege role used ONLY by the VULNERABLE SQLi query.
# It has SELECT on products and nothing else.
LAB_DATABASE_URL=postgres://lab_reader:CHANGE_ME@127.0.0.1:5432/webseclab

# Session signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# Superuser URL used ONLY by `npm run db:reset` to create the two roles above.
# Not used by the running application.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Optional: override the seeded demo passwords
# SEED_ADMIN_PASSWORD=Admin-Lab-Demo-2026
# SEED_USER_PASSWORD=User-Lab-Demo-2026

# Residual-risk outcome model — share of SAFE-mode attempts in which the controls
# deliberately do not engage, so the event log has a realistic minority tail
# instead of exactly two possible row shapes. Every affected event records
# request_data.outcomeBasis = 'RESIDUAL_RISK'.
#
#   0      (default) the global mode decides every result — reproducible, and what
#           the scripted demonstration and the acceptance suite assume
#   0.12   roughly one attempt in eight slips through SAFE
#
# RESIDUAL_RISK_RATE=0
